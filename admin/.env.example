# Copy to admin/.env.development (already filled for the development API)
# or to admin/.env.development.local to override it. Vite loads .env.development
# for `npm run dev` only. Production builds do not read it.
#
# Leave VITE_API_BASE empty to use the in-memory mock client and demo passwords.
# When it is set, demo passwords stop working and sign-in is Cognito + BFF cookies.

# Development Function URL. The client strips a trailing slash.
# VITE_API_BASE=https://npszewzrclcar6mehcbigdfhge0blmpb.lambda-url.eu-west-1.on.aws

# Hosted UI host without a scheme. Both domain and client id are required
# before "Continuar con Cognito" redirects. The browser stores only the PKCE
# verifier and state (sessionStorage), never access or refresh tokens.
# VITE_COGNITO_DOMAIN=automatic-envelopes-admin-dev.auth.eu-west-1.amazoncognito.com
# VITE_COGNITO_CLIENT_ID=1oekl4qltck4r8aijfg0k39q9c
# VITE_COGNITO_REDIRECT_URI=http://localhost:5173/admin/auth/callback
# VITE_COGNITO_LOGOUT_URI=http://localhost:5173/admin/login

# Served path. Default is /admin/ for a subfolder next to the static site.
# Use / for the recommended host admin.core-webhook.eu (not this development file).
# VITE_BASE=/admin/
