# Leave VITE_API_BASE empty to use the in-memory mock client.
# VITE_API_BASE=https://api.core-webhook.eu

# When both domain and client id are set, "Continuar con Cognito" redirects
# to the Hosted UI. Otherwise the login screen only explains the plug-in.
# VITE_COGNITO_DOMAIN=auth.core-webhook.eu
# VITE_COGNITO_CLIENT_ID=
# VITE_COGNITO_REDIRECT_URI=http://localhost:5173/admin/auth/callback

# Served path. Default is /admin/ so the portal can live next to the static site.
# Use / when deploying to a dedicated host such as admin.core-webhook.eu.
# VITE_BASE=/admin/
