# Leave VITE_API_BASE empty to use the in-memory mock client.
# When set, the portal calls the API and demo passwords stop working.
# VITE_API_BASE=https://api.core-webhook.eu

# Hosted UI. Both are required before "Continuar con Cognito" redirects.
# The browser stores only the PKCE verifier and state (sessionStorage), never tokens.
# VITE_COGNITO_DOMAIN=auth.core-webhook.eu
# VITE_COGNITO_CLIENT_ID=
# VITE_COGNITO_REDIRECT_URI=https://admin.core-webhook.eu/auth/callback
# VITE_COGNITO_LOGOUT_URI=https://admin.core-webhook.eu/login

# Served path. Default is /admin/ for a subfolder next to the static site.
# Use / for the recommended host admin.core-webhook.eu.
# VITE_BASE=/admin/
