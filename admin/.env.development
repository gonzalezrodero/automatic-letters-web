# Loaded by `npm run dev` only (Vite mode "development").
# `npm run build` does not read this file, so these values are not baked into dist.
#
# VITE_API_BASE is set, so demo passwords are disabled. Sign in with Cognito.
# The portal then uses the BFF cookie session (credentials: 'include').
# Tokens are not stored in localStorage or sessionStorage.
#
# To run the in-memory mock instead, create admin/.env.development.local
# (gitignored) with an empty VITE_API_BASE=. That file overrides this one.

# Development Function URL. The client strips a trailing slash.
VITE_API_BASE=https://npszewzrclcar6mehcbigdfhge0blmpb.lambda-url.eu-west-1.on.aws

# Hosted UI host, no scheme. Authorize URLs are https://<this host>/oauth2/authorize.
VITE_COGNITO_DOMAIN=automatic-envelopes-admin-dev.auth.eu-west-1.amazoncognito.com

# Public PKCE app client id. Do not put a client secret in the browser.
VITE_COGNITO_CLIENT_ID=1oekl4qltck4r8aijfg0k39q9c

# Must match the development Cognito app client callback and logout URLs.
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/admin/auth/callback
VITE_COGNITO_LOGOUT_URI=http://localhost:5173/admin/login

# Portal is served under /admin/. The dev server redirects / to /admin/.
VITE_BASE=/admin/
